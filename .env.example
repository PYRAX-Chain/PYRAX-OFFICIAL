# PYRAX Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===========================================
# Network Configuration
# ===========================================
# Options: mainnet, testnet, devnet
NETWORK=devnet

# ===========================================
# NEURAX AI Configuration
# ===========================================
# Brevo API Key for NEURAX error reporting emails
# Get your API key from: https://app.brevo.com/settings/keys/api
# Errors are emailed to neurax-errors@pyrax.org every 5 minutes
BREVO_API_KEY=your_brevo_api_key_here

# ===========================================
# RPC Configuration
# ===========================================
# Internal RPC URL (for server-side)
RPC_URL=http://localhost:8545

# Public RPC URLs (for frontend)
NEXT_PUBLIC_RPC_URL=https://rpc.pyrax.org
NEXT_PUBLIC_API_URL=https://api.pyrax.org

# ===========================================
# Faucet Configuration
# ===========================================
# Private key for faucet wallet (KEEP SECRET!)
FAUCET_PRIVATE_KEY=your_private_key_here

# Amount of PYRAX to dispense per request
FAUCET_AMOUNT=10

# Rate limit in hours between requests per address
RATE_LIMIT_HOURS=24

# ===========================================
# Database (if using PostgreSQL for indexer)
# ===========================================
# DATABASE_URL=postgres://user:password@localhost:5432/pyrax

# ===========================================
# SSL Configuration
# ===========================================
# Cloudflare Origin Certificate paths
SSL_CERT_PATH=/etc/ssl/cloudflare/pyrax.org.pem
SSL_KEY_PATH=/etc/ssl/cloudflare/pyrax.org.key
