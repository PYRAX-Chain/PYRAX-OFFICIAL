{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Inferno Node",
    "version": "0.4.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "clipboard": {
        "all": true,
        "writeText": true,
        "readText": true
      },
      "shell": {
        "open": true
      },
      "window": {
        "all": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "scope": ["$APP/**", "$RESOURCE/**", "$HOME/**", "$DATA/**", "**"]
      },
      "path": {
        "all": true
      },
      "process": {
        "all": true,
        "relaunch": true
      },
      "notification": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "org.pyrax.inferno",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "resources/*"
      ],
      "externalBin": [],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "webviewInstallMode": {
          "type": "downloadBootstrapper"
        },
        "wix": null,
        "nsis": {
          "installerIcon": "icons/icon.ico",
          "headerImage": "icons/128x128.png",
          "sidebarImage": "icons/icon.png",
          "displayLanguageSelector": false,
          "license": null
        }
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37 | libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-common"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "publisher": "PYRAX Chain",
      "shortDescription": "Inferno Node - Decentralized Blockchain Node",
      "longDescription": "Inferno Node is a fully decentralized blockchain node client with integrated wallet, mining, and staking capabilities.",
      "category": "Finance"
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RjYyRjI5OEEwNkY5MzYKUldRMitRYUtLUy8yVlZ0N040azNEUlVqcjNGMmVtaDhWcWR3Z1diRDY3ZVRmeDQ5eVJTVTNSOWEK",
      "endpoints": [
        "https://github.com/PYRAX-Chain/PYRAX-OFFICIAL/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Inferno Node",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ]
  }
}
