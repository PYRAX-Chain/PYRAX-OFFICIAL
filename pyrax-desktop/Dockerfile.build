# PYRAX Desktop Build Container
# Use this Dockerfile to build PYRAX Desktop on systems with newer WebKitGTK (Ubuntu 24.04+)
# The build uses Ubuntu 22.04 which has the required webkit2gtk-4.0 libraries
#
# USAGE:
#   cd pyrax-desktop
#   docker build -f Dockerfile.build -t pyrax-desktop-build ..
#   docker run --rm -v $(pwd)/target:/app/pyrax-desktop/src-tauri/target pyrax-desktop-build
#
# The built binaries will be in ./target/release/

FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for Tauri v1 (requires webkit2gtk-4.0)
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    curl \
    git \
    pkg-config \
    cmake \
    clang \
    lld \
    # Tauri/GTK dependencies (webkit2gtk-4.0 is CRITICAL - not available in Ubuntu 24.04+)
    libgtk-3-dev \
    libwebkit2gtk-4.0-dev \
    libjavascriptcoregtk-4.0-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    # Additional system libraries
    libssl-dev \
    libclang-dev \
    libdbus-1-dev \
    libcairo2-dev \
    libpango1.0-dev \
    libatk1.0-dev \
    libgdk-pixbuf2.0-dev \
    libsoup2.4-dev \
    libglib2.0-dev \
    libgobject-2.0-dev \
    libgio-2.0-dev \
    # RocksDB dependencies (for pyrax-node)
    libsnappy-dev \
    libbz2-dev \
    libzstd-dev \
    liblz4-dev \
    libgflags-dev \
    librocksdb-dev \
    # Node.js for frontend build
    nodejs \
    npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Rust stable (matches release workflow)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.85.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Add Rust targets if needed
RUN rustup target add x86_64-unknown-linux-gnu

# Set working directory
WORKDIR /app

# Copy entire project (need workspace for pyrax-node, pyrax-wallet dependencies)
COPY . .

# Install Node.js dependencies
WORKDIR /app/pyrax-desktop
RUN npm ci

# Build pyrax-node first (required as bundled resource)
WORKDIR /app
RUN cargo build --release -p pyrax-node

# Copy pyrax-node to resources
RUN mkdir -p /app/pyrax-desktop/src-tauri/resources && \
    cp /app/target/release/pyrax-node /app/pyrax-desktop/src-tauri/resources/ && \
    chmod +x /app/pyrax-desktop/src-tauri/resources/pyrax-node

# Build Tauri desktop app
WORKDIR /app/pyrax-desktop
RUN npm run tauri build

# Default command - copy built artifacts to mounted volume
CMD ["sh", "-c", "echo 'Build complete! Binaries in target/release/bundle/'"]
